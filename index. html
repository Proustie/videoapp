/* ---------- Recorte 9:16 ---------- */
function cropGeom() {
  const vw = S.vw, vh = S.vh, maxDim = { low: 854, med: 1280, high: 1920 }[cfg.q] || 1280, even = x => Math.max(2, Math.round(x / 2) * 2);
  if (cfg.crop) {
    const sw = Math.min(vw, Math.round(vh * 9 / 16)), sx = Math.round((vw - sw) * cfg.offset / 100);
    const chh = even(Math.min(vh, maxDim)), cw = even(chh * 9 / 16);
    return { cw, ch: chh, sx, sy: 0, sw, sh: vh };
  }
  const sc = Math.min(1, maxDim / Math.max(vw, vh));
  return { cw: even(vw * sc), ch: even(vh * sc), sx: 0, sy: 0, sw: vw, sh: vh };
}
function updateCrop() {
  const box = $('#cropBox');
  if (!cfg.crop || !S.vw || S.demo || $('#secRes').hidden) { box.hidden = true; return; }
  const W = player.clientWidth, H = player.clientHeight; if (!W || !H) { box.hidden = true; return; }
  const sc = Math.min(W / S.vw, H / S.vh), dw = S.vw * sc, dh = S.vh * sc, ox = (W - dw) / 2, oy = (H - dh) / 2, g = cropGeom();
  Object.assign(box.style, { left: (ox + g.sx * sc) + 'px', top: oy + 'px', width: (g.sw * sc) + 'px', height: dh + 'px' });
