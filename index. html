function stopRecording() { if (S.rec) { S.rec.cancelAll = true; S.rec.stop(); } }
$('#btnRecStop').onclick = stopRecording;
$('#btnRecord').onclick = () => {
  const list = accepted(); if (!list.length) { toast('No hay clips aceptados'); return; }
