<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src blob: data:; media-src blob: data:; worker-src blob:; connect-src 'none'; font-src 'none'; frame-src 'none'; object-src 'none'; manifest-src 'none'; base-uri 'none'; form-action 'none'">
<meta name="referrer" content="no-referrer">
<meta name="robots" content="noindex,nofollow,noarchive">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light dark">
<meta name="format-detection" content="telephone=no">
<title>Selector de clips</title>
<style>
:root{--bg:#f5f6f8;--fg:#14171c;--muted:#5a6372;--card:#fff;--line:#dde1e8;--acc:#3451c7;--acc-fg:#fff;--ok:#2b8a3e;--bad:#c22b2b;--warn:#a85400;--curve:#3451c7;--clip:rgba(52,81,199,.20);--clipoff:rgba(120,120,120,.16);--cut:rgba(120,120,120,.55);--r:14px;--shadow:0 1px 3px rgba(0,0,0,.08)}
[data-theme=dark]{--bg:#0e1014;--fg:#e7e9ee;--muted:#9aa3b2;--card:#171a20;--line:#2a2f39;--acc:#8095ff;--acc-fg:#0e1014;--ok:#69db7c;--bad:#ff8a8a;--warn:#ffb057;--curve:#8095ff;--clip:rgba(128,149,255,.24);--clipoff:rgba(160,160,160,.13);--cut:rgba(170,170,170,.5);--shadow:none}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;padding-bottom:env(safe-area-inset-bottom)}
.skip{position:absolute;left:-999px}.skip:focus{left:8px;top:8px;background:var(--card);padding:8px;z-index:99}
header.top{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;gap:8px;padding:8px max(12px,env(safe-area-inset-left));background:var(--bg);border-bottom:1px solid var(--line)}
h1{font-size:1.1rem;margin:0}
h2{font-size:1.15rem;margin:0 0 12px}
h3{font-size:1rem;margin:0 0 8px}
main{max-width:1100px;margin:0 auto;padding:12px}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:16px;margin:0 0 14px;box-shadow:var(--shadow)}
button,select,input[type=number]{font:inherit;color:inherit}
button{min-height:44px;padding:8px 14px;border-radius:10px;border:1px solid var(--line);background:var(--card);cursor:pointer;touch-action:manipulation}
button:hover:not(:disabled){border-color:var(--acc)}
button:disabled{opacity:.45;cursor:not-allowed}
button.primary{background:var(--acc);color:var(--acc-fg);border-color:var(--acc);font-weight:600}
button.big{width:100%;min-height:52px;font-size:1.05rem;margin-top:8px}
button.ghost{background:transparent}
button.danger{color:var(--bad)}
button.icon{min-width:44px;padding:6px 10px}
:focus-visible{outline:3px solid var(--acc);outline-offset:2px}
select,input[type=number]{min-height:44px;padding:6px 10px;border-radius:10px;border:1px solid var(--line);background:var(--card);max-width:100%}
input[type=range]{width:100%;min-height:36px;accent-color:var(--acc)}
.hbtns{display:flex;gap:6px;flex-wrap:wrap}
.hbtns span{font-size:.85rem}
.row{display:flex;flex-wrap:wrap;gap:8px;margin:8px 0}
.muted,.hint{color:var(--muted)}
.hint{font-size:.85rem;margin:4px 0 0}
.drop{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;min-height:130px;border:2px dashed var(--line);border-radius:var(--r);text-align:center;padding:16px;cursor:pointer}
.drop.over{border-color:var(--acc);background:var(--clip)}
.drop small{color:var(--muted)}
.grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px}
fieldset{border:0;padding:0;margin:0;min-width:0}
legend,.field>label{font-weight:600;margin-bottom:6px;display:block;padding:0}
.seg{display:flex;flex-wrap:wrap;gap:6px}
.seg label{flex:1 1 auto}
.seg input{position:absolute;opacity:0;pointer-events:none}
.seg span{display:flex;align-items:center;justify-content:center;min-height:44px;padding:6px 12px;border:1px solid var(--line);border-radius:10px;cursor:pointer;text-align:center}
.seg input:checked+span{background:var(--acc);color:var(--acc-fg);border-color:var(--acc);font-weight:600}
.seg input:focus-visible+span{outline:3px solid var(--acc);outline-offset:2px}
label.inline{display:flex;align-items:center;gap:8px;margin-top:8px}
label.check{display:flex;align-items:center;gap:10px;min-height:44px}
label.check input{width:22px;height:22px;accent-color:var(--acc)}
details{margin-top:12px;border-top:1px solid var(--line);padding-top:8px}
summary{cursor:pointer;min-height:40px;display:flex;align-items:center;font-weight:600}
.wgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:8px 16px}
.bar{height:12px;background:var(--line);border-radius:6px;overflow:hidden}
#progBar{height:100%;width:0;background:var(--acc);transition:width .3s}
.progRow{display:flex;justify-content:space-between;margin-top:6px;font-variant-numeric:tabular-nums}
.alert{border-radius:12px;padding:12px 14px;margin:0 0 10px;border:1px solid var(--line);background:var(--card);display:flex;gap:10px;align-items:flex-start}
.alert.warn{border-color:var(--warn)}.alert.err{border-color:var(--bad)}.alert.ok{border-color:var(--ok)}
.alert div{flex:1}.alert b{display:block}.alert code{font-size:.8rem;word-break:break-all}
.alert button{min-height:36px;padding:4px 10px}
.playerWrap{position:relative;background:#000;border-radius:12px;overflow:hidden}
#player{display:block;width:100%;max-height:60vh;background:#000}
#cropBox{position:absolute;border:2px solid #fff;box-shadow:0 0 0 9999px rgba(0,0,0,.55);pointer-events:none}
#btnReveal{position:absolute;top:8px;right:8px;background:rgba(0,0,0,.6);color:#fff;border-color:transparent;z-index:2}
#demoNote{color:#fff;padding:40px 16px;text-align:center}
.tlWrap{position:relative;margin-top:10px}
canvas.tl{display:block;width:100%;height:150px;border-radius:10px;background:var(--bg);border:1px solid var(--line);touch-action:pan-y}
canvas.tl.small{height:80px;margin-top:10px}
.tlBtns{display:flex;gap:6px;justify-content:flex-end;margin-top:6px}
.tlBtns button{min-width:48px}
.legend{display:flex;flex-wrap:wrap;gap:12px;font-size:.8rem;color:var(--muted);margin-top:4px}
.legend i{display:inline-block;width:14px;height:10px;border-radius:2px;margin-right:4px;vertical-align:middle}
ol.clips{list-style:none;padding:0;margin:12px 0 0;display:grid;gap:10px}
.clip{border:1px solid var(--line);border-radius:12px;padding:10px;display:grid;grid-template-columns:120px 1fr;gap:10px;align-items:start}
.clip.off{opacity:.55}
.clip.sel{border-color:var(--acc);box-shadow:0 0 0 2px var(--clip)}
.thumb{position:relative;width:120px;aspect-ratio:16/9;padding:0;border-radius:8px;overflow:hidden;background:var(--line);min-height:0}
.thumb img{width:100%;height:100%;object-fit:cover;display:block}
.thumb .num{position:absolute;left:4px;top:4px;background:rgba(0,0,0,.65);color:#fff;border-radius:6px;padding:0 6px;font-size:.8rem;font-weight:700}
.thumb .ph{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:1.6rem;color:var(--muted)}
.range{font-variant-numeric:tabular-nums;font-weight:600}
.meta small{color:var(--muted);display:block}
.scoreBar{height:6px;background:var(--line);border-radius:3px;overflow:hidden;margin:4px 0;max-width:220px}
.scoreBar i{display:block;height:100%;background:var(--acc)}
.acts{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:6px}
.acts button{flex:1 1 auto}
.adj{grid-column:1/-1;display:grid;gap:8px;border-top:1px dashed var(--line);padding-top:8px}
.adj .r{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.adj .r b{min-width:48px}
.adj button{min-width:52px;padding:6px 8px}
button.on{background:var(--ok);border-color:var(--ok);color:#fff}
.exportGroup{padding:12px 0;border-top:1px solid var(--line)}
.exportGroup:first-of-type{border-top:0;padding-top:0}
ul.recs{list-style:none;padding:0;margin:8px 0 0;display:grid;gap:6px}
ul.recs li{display:flex;flex-wrap:wrap;gap:6px;align-items:center;border:1px solid var(--line);border-radius:10px;padding:8px}
ul.recs li span{flex:1 1 160px}
#monitor{position:fixed;right:12px;bottom:calc(12px + env(safe-area-inset-bottom));width:168px;aspect-ratio:16/9;border-radius:10px;overflow:hidden;z-index:30;background:#000;box-shadow:0 4px 14px rgba(0,0,0,.35)}
#monitor video{width:100%;height:100%;object-fit:contain;display:block}
#monitor.idle{width:2px;height:2px;right:0;bottom:0;opacity:.01;pointer-events:none;box-shadow:none}
.discreet #player,.discreet .thumb img,.discreet #monitor video{filter:blur(24px) saturate(.5)}
.discreet.reveal #player,.discreet.reveal .thumb img{filter:none}
body:not(.discreet) #btnReveal{display:none}
#panic{position:fixed;inset:0;z-index:100;background:var(--bg);display:flex;align-items:center;justify-content:center}
#panic[hidden]{display:none}
.panicBox{text-align:center;color:var(--muted)}
#toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom));transform:translateX(-50%);background:var(--fg);color:var(--bg);padding:10px 16px;border-radius:10px;z-index:90;max-width:90vw;opacity:0;transition:opacity .25s;pointer-events:none}
#toast.show{opacity:1}
ul.compat{margin:6px 0 0;padding-left:18px;font-size:.9rem}
.ok{color:var(--ok)}.no{color:var(--bad)}
@media (min-width:900px){
 #secRes .resGrid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:16px;align-items:start}
 ol.clips{margin-top:0;max-height:78vh;overflow:auto;padding-right:4px}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body class="discreet">
<a class="skip" href="#main">Saltar al contenido</a>
<header class="top">
  <h1>Selector de clips</h1>
  <div class="hbtns">
    <button id="btnDiscreet" class="icon" aria-pressed="true" title="Modo discreto: difumina imágenes">◐ <span>Discreto</span></button>
    <button id="btnTheme" class="icon" title="Cambiar tema">◑ <span id="themeLbl">Auto</span></button>
    <button id="btnPanic" class="icon danger" title="Ocultar todo al instante (tecla Esc)">✕ <span>Ocultar</span></button>
  </div>
</header>
<div id="nojs" style="margin:12px;padding:14px 16px;border:2px solid #c22b2b;border-radius:12px;background:#fff3f3;color:#14171c">
  <b>Esta página no se está ejecutando.</b><br>
  Estás viendo una vista previa sin JavaScript (por ejemplo, la de la app Archivos en iPhone/iPad). Así el vídeo no se puede cargar. Ábrela en Safari desde una dirección web (https), o en el navegador de un ordenador.
</div>
<main id="main">
  <div id="alerts" aria-live="polite"></div>

  <section class="card" id="secLoad">
    <h2>1. Vídeo</h2>
    <label id="drop" class="drop" tabindex="0">
      <input type="file" id="file" accept="video/*,.mkv,.mov,.m4v,.webm,.mp4,.avi,.ts,.3gp" hidden>
      <strong>Elige un vídeo o arrástralo aquí</strong>
      <small>Se procesa solo en este dispositivo. Nada se sube ni se guarda.</small>
    </label>
    <p id="fileInfo" class="muted"></p>
    <div class="row">
      <button id="btnDemo" class="ghost">Probar modo demo (sin vídeo)</button>
      <button id="btnClear" class="ghost danger" disabled>Borrar todo</button>
    </div>
    <details><summary>Compatibilidad de este navegador</summary><ul id="compat" class="compat"></ul></details>
  </section>

  <section class="card" id="secOpts">
    <h2>2. Opciones</h2>
    <div class="grid2">
      <fieldset>
        <legend>Duración de cada clip</legend>
        <div class="seg" role="radiogroup" aria-label="Duración de cada clip">
          <label><input type="radio" name="dur" value="15"><span>15 s</span></label>
          <label><input type="radio" name="dur" value="30"><span>30 s</span></label>
          <label><input type="radio" name="dur" value="60"><span>60 s</span></label>
          <label><input type="radio" name="dur" value="custom"><span>Otra</span></label>
        </div>
        <label class="inline" id="durCustomWrap">Segundos <input type="number" id="durCustom" min="3" max="600" step="1" inputmode="numeric"></label>
      </fieldset>
      <div class="field">
        <label for="optN">Número de clips: <output id="optNVal"></output></label>
        <input type="range" id="optN" min="1" max="10" step="1">
      </div>
      <fieldset>
        <legend>Estilo</legend>
        <div class="seg" role="radiogroup" aria-label="Estilo de selección">
          <label><input type="radio" name="style" value="intenso"><span>Momentos intensos</span></label>
          <label><input type="radio" name="style" value="equilibrado"><span>Equilibrado</span></label>
          <label><input type="radio" name="style" value="repartido"><span>Repartido</span></label>
        </div>
        <p class="hint" id="styleHint"></p>
      </fieldset>
      <div class="field">
        <label for="optSens">Sensibilidad: <output id="optSensVal"></output></label>
        <input type="range" id="optSens" min="0" max="100" step="5">
        <p class="hint">Más alta: detecta más cortes de plano y silencios y da valor a momentos menos extremos.</p>
      </div>
      <div class="field">
        <label for="optSpeed">Velocidad de análisis</label>
        <select id="optSpeed">
          <option value="auto">Automática (recomendada)</option>
          <option value="2">2x</option><option value="3">3x</option><option value="4">4x</option>
          <option value="6">6x</option><option value="8">8x</option>
        </select>
        <p class="hint">Por encima de 4x algunos navegadores silencian el audio; si pasa, se baja sola a 4x.</p>
      </div>
      <div class="field">
        <label for="optMode">Método de análisis</label>
        <select id="optMode">
          <option value="auto">Automático</option>
          <option value="playback">Reproducción acelerada</option>
          <option value="seek">Compatible (por saltos, más lento)</option>
        </select>
        <p class="hint">Usa «Compatible» si la reproducción acelerada se atasca.</p>
      </div>
    </div>
    <details>
      <summary>Pesos avanzados</summary>
      <p class="hint">Multiplican los pesos del estilo elegido. 100 % = valor por defecto.</p>
      <div class="wgrid" id="wgrid"></div>
      <button id="btnWReset" class="ghost">Restablecer pesos</button>
    </details>
    <details>
      <summary>Privacidad</summary>
      <label class="check"><input type="checkbox" id="pDiscreet"> Difuminar imágenes (modo discreto)</label>
      <label class="check"><input type="checkbox" id="pHide"> Ocultar y pausar al cambiar de app o pestaña</label>
      <label class="check"><input type="checkbox" id="pNeutral"> Nombres de archivo neutros al exportar (clip_01…)</label>
      <label class="check"><input type="checkbox" id="pMute"> Previsualizaciones sin sonido</label>
      <p class="hint">Solo se guardan estos ajustes en el navegador. Esc o «Ocultar» tapa la pantalla al instante.</p>
    </details>
    <button id="btnAnalyze" class="primary big" disabled>Analizar vídeo</button>
  </section>

  <section class="card" id="secProg" hidden>
    <h2 id="progTitle">Analizando…</h2>
    <div class="bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" id="progAria"><div id="progBar"></div></div>
    <div class="progRow"><span id="progPct">0 %</span><span id="progEta"></span></div>
    <p id="progInfo" class="muted"></p>
    <canvas id="liveCurve" class="tl small" aria-hidden="true"></canvas>
    <button id="btnTap" class="primary big" hidden>Toca para continuar</button>
    <div class="row">
      <button id="btnPause">Pausar</button>
      <button id="btnStopUse">Detener y usar lo analizado</button>
      <button id="btnCancel" class="danger">Cancelar</button>
    </div>
  </section>

  <section class="card" id="secRes" hidden>
    <h2>3. Resultados</h2>
    <p id="resSummary" class="muted"></p>
    <div class="resGrid">
      <div>
        <div id="playerWrap" class="playerWrap">
          <video id="player" playsinline webkit-playsinline controls preload="metadata" disablepictureinpicture></video>
          <div id="cropBox" hidden></div>
          <button id="btnReveal">Mostrar imagen</button>
          <div id="demoNote" hidden>Modo demo: no hay vídeo. La curva y los clips salen de datos sintéticos.</div>
        </div>
        <div class="tlWrap">
          <canvas id="timeline" class="tl" role="img" aria-label="Curva de interés con los clips marcados"></canvas>
          <div class="legend"><span><i style="background:var(--curve)"></i>Interés</span><span><i style="background:var(--clip)"></i>Clip aceptado</span><span><i style="background:var(--clipoff)"></i>Descartado</span><span><i style="background:var(--cut)"></i>Corte de plano</span></div>
          <div class="tlBtns"><button id="zOut" aria-label="Alejar">−</button><button id="zReset">Todo</button><button id="zIn" aria-label="Acercar">+</button></div>
          <p class="hint">Toca para saltar · arrastra para moverte · pellizca o usa la rueda para hacer zoom · doble toque para ver todo.</p>
        </div>
        <div class="row">
          <button id="btnRecalc">Recalcular clips</button>
          <button id="btnAcceptAll" class="ghost">Aceptar todos</button>
        </div>
      </div>
      <ol id="clipList" class="clips" aria-label="Clips seleccionados"></ol>
    </div>
  </section>

  <section class="card" id="secExp" hidden>
    <h2>4. Exportar</h2>
    <div class="exportGroup">
      <h3>Marcas de tiempo</h3>
      <div class="row"><button id="btnJSON">Descargar JSON</button><button id="btnCSV">Descargar CSV</button></div>
    </div>
    <div class="exportGroup">
      <h3>Script de ffmpeg (calidad original)</h3>
      <div class="row"><button id="btnSH">.sh (Mac/Linux)</button><button id="btnBAT">.bat (Windows)</button></div>
      <p class="hint">Corta sin recodificar: es instantáneo y conserva la calidad, pero cada clip empieza en el fotograma clave anterior más cercano (puede adelantarse 1–2 s). El script incluye, comentada, una alternativa exacta que recodifica. Guárdalo junto al vídeo y ejecútalo pasando la ruta del vídeo.</p>
    </div>
    <div class="exportGroup" id="recGroup">
      <h3>Grabar clips como vídeo</h3>
      <p id="recSupport" class="hint"></p>
      <div class="grid2">
        <div class="field"><label for="expFmt">Formato</label><select id="expFmt"></select></div>
        <div class="field"><label for="expQ">Calidad</label><select id="expQ">
          <option value="low">Baja (máx. 854 px, 2,5 Mb/s)</option>
          <option value="med">Media (máx. 1280 px, 5 Mb/s)</option>
          <option value="high">Alta (máx. 1920 px, 8 Mb/s)</option>
        </select></div>
      </div>
      <label class="check"><input type="checkbox" id="expCrop"> Recorte vertical 9:16</label>
      <div id="offsetWrap" class="field"><label for="expOffset">Desplazamiento horizontal: <output id="expOffsetVal"></output></label><input type="range" id="expOffset" min="0" max="100" step="1"></div>
      <div class="row"><button id="btnRecord" class="primary">Grabar clips aceptados</button><button id="btnRecStop" class="danger" hidden>Detener grabación</button></div>
      <p id="recStatus" class="muted" aria-live="polite"></p>
      <ul id="recList" class="recs"></ul>
    </div>
  </section>
</main>
<div id="monitor" class="idle" aria-hidden="true"></div>
<div id="panic" hidden><div class="panicBox"><p>No hay nada abierto.</p><button id="btnUnpanic">Volver</button></div></div>
<div id="toast" role="status" aria-live="polite"></div>

<script>
'use strict';
/* =====================================================================
   CORE: funciones puras de puntuación y selección (sin DOM).
   ===================================================================== */
const Core = (() => {
  // Pesos base por estilo. a=audio (RMS), p=picos, m=movimiento, c=cortes de plano, s=penalización por silencio.
  const WEIGHTS = {
    intenso:     { a: .30, p: .25, m: .30, c: .15, s: .35 },
    equilibrado: { a: .30, p: .15, m: .30, c: .15, s: .25 },
    repartido:   { a: .30, p: .15, m: .30, c: .15, s: .25 }
  };
  const clamp = (x, a, b) => x < a ? a : x > b ? b : x;

  function percentile(sorted, p) {
    const n = sorted.length; if (!n) return 0;
    const i = (n - 1) * p, lo = Math.floor(i), hi = Math.ceil(i);
    return sorted[lo] + (sorted[hi] - sorted[lo]) * (i - lo);
  }
  const sortedCopy = arr => Float64Array.from(arr).sort();

  // Normaliza con percentiles (robusto ante picos aislados), salida 0..1.
  function percentileNorm(arr, lo = .05, hi = .95) {
    const n = arr.length, out = new Float32Array(n); if (!n) return out;
    const s = sortedCopy(arr), a = percentile(s, lo), b = percentile(s, hi), d = b - a;
    if (!(d > 1e-9)) return out;
    for (let i = 0; i < n; i++) out[i] = clamp((arr[i] - a) / d, 0, 1);
    return out;
  }
  // Para señales dispersas (cortes): escala por un percentil alto sin anular lo poco que hay.
  function sparseNorm(arr) {
    const n = arr.length, out = new Float32Array(n); if (!n) return out;
    const s = sortedCopy(arr), top = Math.max(percentile(s, .98), s[n - 1] * .5, 1e-9);
    for (let i = 0; i < n; i++) out[i] = clamp(arr[i] / top, 0, 1);
    return out;
  }
  function smooth(arr, r) {
    const n = arr.length, out = new Float32Array(n);
    if (r <= 0) { out.set(arr); return out; }
