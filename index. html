async function recordAll(list) {
  const mime = $('#expFmt').value || recTypes[0][0], label = (recTypes.find(r => r[0] === mime) || [, ''])[1];
  const g = cropGeom(), q = { low: 2.5e6, med: 5e6, high: 8e6 }[cfg.q], vbr = Math.round(q * (cfg.crop ? .6 : 1));
  S.auxBusy = 'rec'; $('#btnRecord').hidden = true; $('#btnRecStop').hidden = false; $('#monitor').classList.remove('idle');
  WL.on();
  const status = $('#recStatus'); let cancelled = false, lastType = '';
  const ctrl = S.rec = { cancelAll: false, stop() {}, hidden() {}, visible() {} };
  try {
    for (let i = 0; i < list.length; i++) {
      if (ctrl.cancelAll) { cancelled = true; break; }
      status.textContent = `Grabando clip ${i + 1} de ${list.length} en ${label}…`;
      const out = await recordOne(list[i], g, mime, vbr, ctrl, pct => { status.textContent = `Grabando clip ${i + 1} de ${list.length} en ${label}… ${Math.round(pct)} %`; });
