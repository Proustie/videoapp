      else if (now - lpW > 12000) {
        if (++stalls > 3) { finish('stall'); return; }
        job.info(`El vídeo se ha atascado en ${fmt(t)}; saltando un poco…`);
        v.currentTime = Math.min(S.dur, t + 1 + stalls); fp.reset(); lpW = now; tryPlay();
      }
      if (v.paused && !v.ended) tryPlay();
      if (now - chkW > 3000) {
        const eff = (t - chkT) / ((now - chkW) / 1000);
        effEMA = effEMA ? effEMA * .6 + eff * .4 : eff;
        if (!manual()) {
