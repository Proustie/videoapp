/* ---------- Análisis: reproducción acelerada ---------- */
const RATES = [2, 3, 4, 6, 8];
function playbackLoop(job, pp) {
  return new Promise(resolve => {
    const v = aux, raw = job.raw, an = S.analyser, fp = makeFrameProc(raw);
